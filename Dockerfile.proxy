FROM nginx:alpine

# Копируем свой конфиг вместо дефолтного
COPY /proxy/default.conf /etc/nginx/conf.d/default.conf

# Копируем статику фронтенда прямо в образ прокси —
# теперь Nginx раздаёт и HTML, и проксирует API.
COPY /proxy/index.html /usr/share/nginx/html/index.html

EXPOSE 80

# Дефолтный CMD у nginx:alpine уже правильный — переопределять не нужно
