# Используем официальный базовый образ MongoDB версии 4.4
FROM mongo:4.4

# Настраиваем переменные окружения, которые MongoDB использует 
# для автоматического создания root-пользователя при первом старте
ENV MONGO_INITDB_ROOT_USERNAME=root
ENV MONGO_INITDB_ROOT_PASSWORD=example

# Открываем стандартный порт MongoDB наружу контейнера
EXPOSE 27017

# Стандартная команда запуска (берется из базового образа, 
# пишем для наглядности)
CMD ["mongod"]
